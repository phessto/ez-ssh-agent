[Unit]
Description=Persistent SSH Agent
# Long-lived user agent so password-locked keys can be unlocked once per boot.
# Run install-user-unit.sh before any ssh-add. It checks linger and warns
# first: without linger the agent dies on logout and keys are lost; with
# linger the agent and unlocked keys stay in memory until reboot.

[Service]
Type=simple
ExecStart=/usr/bin/ssh-agent -D -a %t/ssh-agent.socket
Restart=on-failure
RestartSec=1
SuccessExitStatus=2

[Install]
WantedBy=default.target
